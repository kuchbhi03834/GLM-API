# Copy this file to .env.

# --- Server & Network ---
HOST=127.0.0.1
PORT=8001                                # Default port 8001 (runs smoothly alongside DeepSeek on 8000)
RATE_LIMIT_PER_MINUTE=60
API_KEY=                                 # Optional Bearer token for incoming clients

# --- Authentication Mode ---
# Option 1: Official Zhipu AI Open Platform (free GLM-4-Flash API key from open.bigmodel.cn)
# ZHIPU_API_KEY=your_zhipu_api_key_here

# Option 2: Web Chat Mode (chatglm.cn session via Playwright browser login)
# Run `python -m glm.auth` to log in once if not using ZHIPU_API_KEY
# GLM_PROFILE_DIR=session/profile
# SERVER_INTERACTIVE_LOGIN=1

# --- Concurrency & Queueing ---
GLM_WORKERS=4
GLM_REQUEST_TIMEOUT=30.0
UPSTREAM_RETRY_AFTER=30
DEBUG_REQUESTS=0
